# Copy to .env.local and fill in once Supabase is provisioned (Phase 2).
# Client-safe values only — EXPO_PUBLIC_* is bundled into the app, so it must never hold
# a secret. The Anthropic/OpenAI key and the Supabase service role key live only in
# Supabase Edge Function secrets (`supabase secrets set ...`), never here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
